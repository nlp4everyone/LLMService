# Copy this file to .env and adjust values as needed.
# ==== compose_serving.yml (vLLM) ====
VLLM_PORT=8100
MODEL_NAME=Qwen/Qwen3-4B
MAX_MODEL_LEN=4096
NUM_SEQS=128
BATCHED_TOKENS=4096
SERVING_API_KEY=token
GPU_MEM_UTIL=0.8

# ==== compose_monitoring.yml (Prometheus / Grafana / DCGM) ====
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
DCGM_PORT=9400
